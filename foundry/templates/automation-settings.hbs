<form
  class="boa-automation-settings-form standard-form"
  autocomplete="off"
>
  <fieldset class="boa-automation-settings-group">
    <legend>
      {{localize "BOA.settings.automation.groupSummons"}}
    </legend>

    <div class="boa-automation-setting">
      <div class="boa-automation-setting-copy">
        <label for="boa-elemental-totem-automation">
          {{localize
            "BOA.settings.automation.elementalTotemName"
          }}
        </label>
        <p class="hint">
          {{localize
            "BOA.settings.automation.elementalTotemHint"
          }}
        </p>
      </div>

      <input
        id="boa-elemental-totem-automation"
        type="checkbox"
        name="elementalTotemAutomation"
        {{checked elementalTotemAutomation}}
      >
    </div>

    <div class="boa-automation-setting">
      <div class="boa-automation-setting-copy">
        <label for="boa-demon-automation">
          {{localize
            "BOA.settings.automation.demonName"
          }}
        </label>
        <p class="hint">
          {{localize
            "BOA.settings.automation.demonHint"
          }}
        </p>
      </div>

      <input
        id="boa-demon-automation"
        type="checkbox"
        name="demonAutomation"
        {{checked demonAutomation}}
      >
    </div>
  </fieldset>

  <footer class="form-footer">
    <button type="submit">
      <i class="fas fa-save" aria-hidden="true"></i>
      {{localize "BOA.settings.automation.save"}}
    </button>
  </footer>
</form>
